  {
    "id": 4,
    "title": "I got a Merge Conflict!",
    "theMess": "You ran git merge and Git halted because both the active branch and target branch modified the exact same line of code in app.js.",
    "explanation": "Git cannot automatically decide which version of conflicting lines to keep. It inserts conflict markers (<<<<<<<, =======, >>>>>>>) into the file and pauses so you can manually select the correct code, stage the resolution, and commit.",
    "fixSteps": [
      "git status",
      "resolve conflict markers manually",
      "git add app.js",
      "git commit -m \"resolved conflict\""
    ],
    "labPrefillState": {
